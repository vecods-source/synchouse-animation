{
  "name": "synchouse-welcome-animation",
  "version": "1.0.0",
  "description": "A welcome animation component for SyncHouse projects",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.300.0"
  },
  "keywords": [
    "react",
    "animation",
    "welcome",
    "synchouse"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/synchouse/synchouse-welcome-animation"
